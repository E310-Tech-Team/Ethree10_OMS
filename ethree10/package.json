{
  "name": "ethree10",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx watch workers/index.ts\"",
    "dev:next": "next dev",
    "build": "prisma generate && node scripts/build-atomic.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "e2e:server": "NODE_ENV=production NEXT_PUBLIC_E2E_TEST_AUTH=true E2E_TEST_AUTH=true next build && NODE_ENV=production E2E_TEST_AUTH=true next start --hostname 127.0.0.1 --port 3100",
    "check:readiness": "tsx scripts/check-readiness.ts --production",
    "check:readiness:db": "tsx scripts/check-readiness.ts --production --with-db",
    "check:smoke": "tsx scripts/check-smoke.ts",
    "check:request-cycle": "NODE_ENV=test tsx scripts/request-cycle-smoke.ts",
    "check:security-headers": "tsx scripts/check-security-headers.ts",
    "check:backups": "tsx scripts/check-backups.ts",
    "check:release-controls": "tsx scripts/check-release-controls.ts",
    "check:monitoring": "tsx scripts/check-monitoring.ts",
    "check:pilot-readiness": "tsx scripts/check-pilot-readiness.ts",
    "audit:archive": "tsx scripts/archive-audit-logs.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:catalog": "tsx scripts/bootstrap-catalog.ts",
    "db:studio": "prisma studio",
    "worker": "tsx workers/index.ts",
    "db:deploy": "prisma migrate deploy",
    "test:integration:prepare": "prisma migrate deploy",
    "test:all": "vitest run && vitest run --config vitest.docs.config.ts && vitest run --config vitest.integration.config.ts",
    "test:docs": "vitest run --config vitest.docs.config.ts",
    "verify": "bash scripts/verify.sh",
    "ensure:bucket": "tsx scripts/ensure-bucket.ts",
    "verify:governance": "tsx scripts/verify-governance.ts",
    "audit:baseline": "tsx scripts/check-audit-baseline.ts",
    "check:reconciliation": "tsx scripts/check-reconciliation.ts",
    "assign:branch-heads": "tsx scripts/assign-branch-heads.ts",
    "merge:branches": "tsx scripts/merge-branches.ts",
    "memberships": "tsx scripts/memberships.ts",
    "ops:report": "tsx scripts/ops-report.ts",
    "csp:violations": "tsx scripts/csp-violations.ts",
    "assign:task": "tsx scripts/assign-task.ts",
    "departments": "tsx scripts/departments.ts",
    "probe:delivery": "tsx scripts/probe-delivery.ts",
    "probe:money": "tsx scripts/probe-money.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "1.0.12",
    "@react-pdf/renderer": "~4.9.0",
    "@sentry/nextjs": "10.66.0",
    "@tanstack/react-query": "^5.106.1",
    "@trpc/client": "^11.25.0",
    "@trpc/react-query": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "bullmq": "^6.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.4.3",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "nodemailer": "10.3.1",
    "otplib": "^13.6.0",
    "pino": "^9.6.0",
    "posthog-js": "^1.447.3",
    "posthog-node": "^5.63.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "resend": "6.37.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "24.0.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^10.0.6",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
