// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (magic-link + OAuth verification)
// ============================================================

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// IDENTITY
// ============================================================

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  emailVerified              DateTime?
  hashedPassword             String?
  name                       String
  avatarUrl                  String?
  phone                      String?
  phoneVerifiedAt            DateTime?
  phoneVerificationCode      String?
  // A six-digit code is a million guesses. Randomness alone does not carry
  // it, so the code also stops being valid — see server/trpc/routers/whatsapp.ts.
  phoneVerificationExpiresAt DateTime?
  timezone                   String    @default("Africa/Lagos")
  workingHoursPerWeek        Int       @default(40)
  isSuperAdmin               Boolean   @default(false)
  mfaEnabled                 Boolean   @default(false)
  mfaSecret                  String?
  mfaRecoveryCodes           String[]
  deactivatedAt              DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  memberships             Membership[]
  pushSubscriptions       PushSubscription[]
  skills                  UserSkill[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]                 @relation("ActorAuditLogs")
  authoredComments        TaskComment[]
  authoredReports         Report[]                   @relation("ReportAuthoredBy")
  finalizedReports        Report[]                   @relation("ReportFinalizedBy")
  reportAmendments        ReportAmendment[]
  timeLogs                TimeLog[]                  @relation("UserTimeLogs")
  taskContributions       TaskContributor[]          @relation("TaskContributors")
  staffAvailability       StaffAvailability[]
  createdDeliverables     Deliverable[]              @relation("DeliverableCreatedBy")
  deliverableVersions     DeliverableVersion[]       @relation("DeliverableVersionCreatedBy")
  taskReviews             TaskReview[]               @relation("TaskReviews")
  uploadedAttachments     Attachment[]               @relation("AttachmentUploadedBy")
  oauthAccounts           OAuthAccount[]
  budgetsSubmitted        Budget[]                   @relation("BudgetSubmittedBy")
  budgetsDecided          Budget[]                   @relation("BudgetDecidedBy")
  budgetDecisions         BudgetDecision[]
  expensesRequested       Expense[]                  @relation("ExpenseRequestedBy")
  expensesApproved        Expense[]                  @relation("ExpenseApprovedBy")
  expensesPaid            Expense[]                  @relation("ExpensePaidBy")
  invoicesConfirmed       Invoice[]                  @relation("InvoicePaymentConfirmedBy")
  delegationsGranted      BudgetApprovalDelegation[] @relation("DelegationGrantedBy")
  delegationsHeld         BudgetApprovalDelegation[] @relation("DelegationDelegate")
  delegationsRevoked      BudgetApprovalDelegation[] @relation("DelegationRevokedBy")
  serviceCapabilities     ServiceCapability[]        @relation("UserServiceCapabilities")
  taskAssignments         TaskAssignment[]           @relation("TaskAssignmentAssignee")

  @@index([email])
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================
// WORKSPACES, MEMBERSHIPS, DEPARTMENTS
// ============================================================

// The agency (Ethree10) is implicit — there is no agency row. An Organization represents a
// CLIENT org (sibling initiative or external client) whose people submit and track work.
model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  isExternal      Boolean   @default(false)
  description     String?
  logoUrl         String?
  brandColor      String?
  defaultCurrency String    @default("NGN")
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests Request[]
  projects Project[]
  leads    Lead[]
  invoices Invoice[]
  receipts Receipt[]
  reports  Report[]
}

model Position {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships       Membership[]
  taskContributions TaskContributor[]
}

/// Authorization roles. Org mapping: a `Team` row is an agency **Branch**
/// (Digital Media, Tech & Product) and a `SubUnit` row is a **Department**
/// inside a branch. `branch_head` leads a Team; `department_lead` leads a SubUnit.
enum Role {
  /// Technical platform owner. Escape hatch, not an operational role.
  super_admin
  /// Chief Executive. Sees everything, approves project budgets, may write notes.
  /// Deliberately has no assignment, routing or delivery write power.
  chief_executive
  /// Chief Operating Officer. Below the Chief Executive, above every other role.
  /// Full operations and agency-wide read; never approves budgets by role, and
  /// never executes payments. See docs/coo-role-plan.md.
  chief_operating_officer
  /// Runs agency operations and configuration. No budget approval, no payments.
  agency_admin
  /// Confirms payments and issues receipts. Cannot approve the budgets it pays against.
  finance_manager
  /// Heads one branch (Digital Media or Tech & Product) and its departments.
  branch_head
  /// Leads one department inside a branch.
  department_lead
  /// Delivers the work.
  team_member
}

model Membership {
  id                String    @id @default(cuid())
  userId            String
  role              Role
  teamId            String?
  subUnitId         String?
  positionId        String?
  title             String?
  isPrimary         Boolean   @default(false)
  // Capability toggle: lets a `member` manage projects (create/update projects, create/assign
  // tasks) without granting a separate lead role. Ignored for non-member roles.
  canManageProjects Boolean   @default(false)
  invitedAt         DateTime?
  acceptedAt        DateTime?
  removedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id])
  subUnit  SubUnit?  @relation(fields: [subUnitId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@unique([userId, role, teamId, subUnitId])
  @@index([userId])
}

// Teams belong to the single implicit Ethree10 agency.
model Team {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String?
  icon        String?
  leadId      String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subUnits         SubUnit[]
  memberships      Membership[]
  integrations     Integration[]
  requestsRoutedTo Request[]     @relation("RequestRoutedTeam")
  projects         Project[]
  services         Service[]
}

model Service {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String?
  teamId               String?
  requiredBriefFields  Json     @default("[]")
  expectedDeliverables Json     @default("[]")
  defaultUrgency       Urgency  @default(medium)
  defaultSlaHours      Int?
  requiredReviews      Json     @default("[]")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  team         Team?               @relation(fields: [teamId], references: [id])
  requests     Request[]
  capabilities ServiceCapability[]
  tasks        Task[]

  @@index([teamId])
  @@index([isActive])
}

model SubUnit {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  slug        String
  description String?
  leadId      String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  tasks        Task[]
  integrations Integration[]

  @@unique([teamId, slug])
  @@index([teamId])
}

// ============================================================
// SKILLS
// ============================================================

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  users UserSkill[]
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  expert
}

/// An explicit statement that a person can deliver a service.
///
/// Explicit rather than inferred from skills: "can handle Video Production" is a
/// decision a lead makes, not something to guess from a skill list, and it is
/// the record an assignment is justified against later. Skills are what someone
/// knows; capability is what they are cleared to deliver. `suggestFromSkills`
/// bridges the two without conflating them.
///
/// See docs/service-assignment-plan.md §4.1.
model ServiceCapability {
  id          String     @id @default(cuid())
  userId      String
  serviceId   String
  level       SkillLevel @default(intermediate)
  /// Cleared rather than deleted, so a past assignment stays explicable.
  revokedAt   DateTime?
  grantedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User    @relation("UserServiceCapabilities", fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([serviceId, revokedAt])
  @@index([userId, revokedAt])
}

model UserSkill {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel @default(intermediate)
  createdAt DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

// ============================================================
// LEADS, REQUESTS, PROJECTS
// ============================================================

enum LeadStatus {
  new
  contacted
  converted
  rejected
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String
  phone          String?
  organization   String?
  message        String
  source         String?
  status         LeadStatus @default(new)
  organizationId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org Organization? @relation(fields: [organizationId], references: [id])

  @@index([status])
}

enum Urgency {
  low
  medium
  high
  critical
}

enum RequestStage {
  submitted
  needs_clarification
  pending_approval
  under_review
  scoping
  proposal
  approved
  in_progress
  in_review
  delivered
  closed
  rejected
  on_hold
  cancelled
}

model Request {
  id                   String       @id @default(cuid())
  code                 String       @unique
  publicToken          String?      @unique
  publicTokenExpiresAt DateTime?
  publicTokenRevokedAt DateTime?
  organizationId       String
  submittedById        String?
  requesterName        String?
  requesterEmail       String?
  requesterPhone       String?
  title                String
  description          String
  projectType          String
  serviceId            String?
  expectedOutcome      String?
  expectedDeliverables String?
  acceptanceCriteria   String?
  supportingLinks      String[]     @default([])
  consentToEmail       Boolean      @default(false)
  urgency              Urgency      @default(medium)
  deadline             DateTime?
  stage                RequestStage @default(submitted)
  routedTeamId         String?
  primaryContact       String?
  externalRef          String?
  approvedById         String?
  rejectedReason       String?
  budgetEstimate       Decimal?     @db.Decimal(14, 2)
  currency             String       @default("NGN")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  service      Service?            @relation(fields: [serviceId], references: [id])
  routedTeam   Team?               @relation("RequestRoutedTeam", fields: [routedTeamId], references: [id])
  project      Project?
  proposals    Proposal[]          @relation("RequestProposals")
  stageEvents  RequestStageEvent[]
  attachments  Attachment[]        @relation("RequestAttachments")
  comments     TaskComment[]       @relation("RequestComments")

  @@index([organizationId])
  @@index([stage])
  @@index([routedTeamId])
  @@index([serviceId])
}

// Agency-global approval rules (the agency is implicit).
model ApprovalRule {
  id               String   @id @default(cuid())
  name             String
  triggerCondition Json // e.g. { isExternal: true, minBudget: 500000 }
  requiredRole     Role
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RequestStageEvent {
  id        String        @id @default(cuid())
  requestId String
  fromStage RequestStage?
  toStage   RequestStage
  actorId   String?
  note      String?
  createdAt DateTime      @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum ProjectStatus {
  active
  in_review
  delivered
  closed
  on_hold
  cancelled
}

model Project {
  id                 String        @id @default(cuid())
  code               String        @unique
  requestId          String        @unique
  organizationId     String
  agencyTeamId       String?
  pmUserId           String?
  name               String
  description        String?
  status             ProjectStatus @default(active)
  startDate          DateTime?
  targetDeliveryDate DateTime?
  actualDeliveryDate DateTime?
  clientRevision     Int           @default(1)
  csatScore          Int?
  csatComment        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  request         Request          @relation(fields: [requestId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  team            Team?            @relation(fields: [agencyTeamId], references: [id])
  tasks           Task[]
  milestones      Milestone[]
  proposals       Proposal[]
  invoices        Invoice[]
  clientDecisions ClientDecision[]
  budget          Budget?
  expenses        Expense[]

  @@index([organizationId])
  @@index([agencyTeamId])
  @@index([status])
}

enum ClientDecisionType {
  accepted
  changes_requested
}

model ClientDecision {
  id              String             @id @default(cuid())
  projectId       String
  decision        ClientDecisionType
  projectRevision Int
  message         String?
  createdAt       DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model PublicRateLimit {
  key         String
  action      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, action, windowStart])
  @@index([expiresAt])
}

enum TaskStatus {
  todo
  in_progress
  blocked
  in_review
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Task {
  id                 String       @id @default(cuid())
  code               String       @unique
  projectId          String
  subUnitId          String?
  /// What kind of work this is, which is what capability is matched against.
  ///
  /// Defaults to the originating request's service, but held per task because a
  /// project can span services — a website with a launch video has tasks
  /// belonging to two, and resolving through the request would give every one
  /// of them whichever service the original request named.
  serviceId          String?
  assigneeUserId     String?
  title              String
  description        String?
  acceptanceCriteria String?
  status             TaskStatus   @default(todo)
  priority           TaskPriority @default(medium)
  estimatedHours     Decimal?     @db.Decimal(6, 2)
  loggedHours        Decimal      @default(0) @db.Decimal(8, 2)
  dueDate            DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  reviewedById       String?
  reviewedAt         DateTime?
  reopenedCount      Int          @default(0)
  completionSummary  String?
  completionEvidence String?
  revision           Int          @default(1)
  /// Set when the task is waiting on something — most often an unanswered
  /// clarification. Surfaced on Workload and My Work so blocked work is visible
  /// rather than silently stalled in someone's queue.
  isBlocked          Boolean      @default(false)
  blockedReason      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service         Service?          @relation(fields: [serviceId], references: [id])
  subUnit         SubUnit?          @relation(fields: [subUnitId], references: [id])
  comments        TaskComment[]     @relation("TaskComments")
  attachments     Attachment[]      @relation("TaskAttachments")
  timeLogs        TimeLog[]         @relation("TaskTimeLogs")
  integrationLink IntegrationLink?
  dependencies    TaskDependency[]  @relation("TaskDeps")
  dependents      TaskDependency[]  @relation("TaskDependents")
  contributors    TaskContributor[]
  assignments     TaskAssignment[]
  deliverables    Deliverable[]
  reviews         TaskReview[]

  @@index([projectId])
  @@index([subUnitId])
  @@index([assigneeUserId])
  @@index([status])
  @@index([dueDate])
}

/// A proposed or decided assignment of a task to a person.
///
/// Separate from `Task.assigneeUserId` on purpose. That column stays the single
/// answer to "who is doing this" and is written **only** when an assignment is
/// approved, so every existing query keeps working. This table is the record of
/// what was proposed, by whom, and what the branch head decided — a rejection
/// and its reason survive rather than being overwritten by the next proposal.
///
/// See docs/service-assignment-plan.md §4.2.
model TaskAssignment {
  id           String               @id @default(cuid())
  taskId       String
  assigneeId   String
  status       TaskAssignmentStatus @default(proposed)
  /// Null when the system proposed it automatically.
  proposedById String?
  proposedAt   DateTime             @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  /// Why this person: capability, load and skills as they were when proposed.
  /// Six months on, "why was this given to them" is answerable from the record
  /// rather than reconstructed.
  rationale    Json?

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User @relation("TaskAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([assigneeId, status])
}

enum TaskAssignmentStatus {
  proposed
  approved
  rejected
  /// Replaced by a newer proposal before anyone decided on it.
  superseded
}

model TaskContributor {
  id               String    @id @default(cuid())
  taskId           String
  userId           String
  positionId       String?
  contributionRole String
  isPrimary        Boolean   @default(false)
  assignedAt       DateTime  @default(now())
  removedAt        DateTime?

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User      @relation("TaskContributors", fields: [userId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id])

  @@unique([taskId, userId, contributionRole])
  @@index([userId, removedAt])
  @@index([taskId, removedAt])
}

enum AvailabilityType {
  available
  limited
  leave
}

model StaffAvailability {
  id              String           @id @default(cuid())
  userId          String
  type            AvailabilityType
  startsAt        DateTime
  endsAt          DateTime
  capacityPercent Int              @default(100)
  reason          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

enum DeliverableKind {
  file
  link
  document
  deployment
  campaign
  other
}

enum DeliverableVisibility {
  internal
  client
}

model Deliverable {
  id              String                @id @default(cuid())
  taskId          String
  createdById     String
  title           String
  kind            DeliverableKind
  visibility      DeliverableVisibility @default(internal)
  currentRevision Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("DeliverableCreatedBy", fields: [createdById], references: [id])
  versions  DeliverableVersion[]

  @@index([taskId, visibility])
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  revision      Int
  createdById   String
  url           String?
  content       String?
  notes         String?
  createdAt     DateTime @default(now())

  deliverable Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("DeliverableVersionCreatedBy", fields: [createdById], references: [id])
  attachments Attachment[]

  @@unique([deliverableId, revision])
  @@index([createdById])
}

enum ReviewDecision {
  approved
  revisions_required
  rejected
  cancelled
}

model TaskReview {
  id         String         @id @default(cuid())
  taskId     String
  reviewerId String
  reviewType String         @default("team_head")
  decision   ReviewDecision
  feedback   String?
  revision   Int
  createdAt  DateTime       @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation("TaskReviews", fields: [reviewerId], references: [id])

  @@index([taskId, revision, createdAt])
  @@index([reviewerId])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String?
  requestId   String?
  authorId    String?
  authorName  String?
  authorEmail String?
  body        String
  mentions    String[]
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task    Task?    @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  request Request? @relation("RequestComments", fields: [requestId], references: [id], onDelete: Cascade)
  author  User?    @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([requestId])
}

model TimeLog {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  hours     Decimal  @db.Decimal(5, 2)
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation("TaskTimeLogs", fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("UserTimeLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

// ============================================================
// PROPOSALS, MILESTONES, INVOICES
// ============================================================

enum ProposalStatus {
  draft
  sent
  accepted
  rejected
  expired
}

model Proposal {
  id           String         @id @default(cuid())
  projectId    String?
  requestId    String?
  title        String
  summary      String?
  version      Int            @default(1)
  status       ProposalStatus @default(draft)
  currency     String         @default("NGN")
  total        Decimal        @db.Decimal(14, 2)
  lineItems    Json
  terms        String?
  validUntil   DateTime?
  sentAt       DateTime?
  acceptedAt   DateTime?
  acceptedById String?
  pdfUrl       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request Request? @relation("RequestProposals", fields: [requestId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([requestId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Lifecycle of a project budget. Only `chief_executive` may move
/// `submitted` → `approved` / `rejected`.
enum BudgetStatus {
  draft
  submitted
  approved
  rejected
}

/// The money envelope for a project. Approval by the Chief Executive is the hard
/// gate: no invoice may be issued to a client and no expense may be paid until
/// `status = approved`.
model Budget {
  id             String       @id @default(cuid())
  projectId      String       @unique
  currency       String       @default("NGN")
  /// Total approved envelope for the project.
  amount         Decimal      @db.Decimal(14, 2)
  /// Inbound: what the client is billed. Invoices are capped at this.
  clientAmount   Decimal?     @db.Decimal(14, 2)
  /// Outbound: what the agency expects to spend. Expenses are capped at this.
  internalAmount Decimal?     @db.Decimal(14, 2)
  status         BudgetStatus @default(draft)
  notes          String?
  submittedById  String?
  submittedAt    DateTime?
  /// The Chief Executive who approved or rejected. Recorded so Finance can be
  /// blocked from confirming payment on a budget it approved itself.
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User?            @relation("BudgetSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?            @relation("BudgetDecidedBy", fields: [decidedById], references: [id])
  decisions   BudgetDecision[]
  expenses    Expense[]

  @@index([status])
}

/// Append-only history of every budget submit / approve / reject. Never updated
/// or deleted — this is the audit trail for the approval chain.
/// A time-boxed grant of `budget.approve` from the Chief Executive to another
/// user — in practice the Chief Operating Officer, so approval does not stall
/// while the executive is away.
///
/// Deliberately NOT a role permission: `chief_executive` stays the only role
/// holding budget.approve in ROLE_PERMISSIONS, which is what
/// GOVERNANCE-AND-JOURNEYS.md states and scripts/verify-governance.ts asserts.
/// See docs/coo-role-plan.md §4.
model BudgetApprovalDelegation {
  id          String    @id @default(cuid())
  grantedById String
  delegateId  String
  reason      String
  startsAt    DateTime  @default(now())
  /// Required, and capped at 90 days by the service. An open-ended delegation
  /// is a second permanent approver by the back door.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  grantedBy User  @relation("DelegationGrantedBy", fields: [grantedById], references: [id])
  delegate  User  @relation("DelegationDelegate", fields: [delegateId], references: [id])
  revokedBy User? @relation("DelegationRevokedBy", fields: [revokedById], references: [id])

  @@index([delegateId, expiresAt])
  @@index([revokedAt])
}

model BudgetDecision {
  id               String       @id @default(cuid())
  budgetId         String
  action           BudgetStatus
  actorId          String?
  note             String?
  amountAtDecision Decimal      @db.Decimal(14, 2)
  createdAt        DateTime     @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([budgetId])
}

/// Outbound spend against an approved budget. Requested by delivery leads,
/// paid by `finance_manager`. The requester may never pay their own expense.
enum ExpenseStatus {
  requested
  approved
  paid
  rejected
}

model Expense {
  id            String        @id @default(cuid())
  projectId     String
  budgetId      String
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("NGN")
  status        ExpenseStatus @default(requested)
  requestedById String
  requestedAt   DateTime      @default(now())
  approvedById  String?
  approvedAt    DateTime?
  paidById      String?
  paidAt        DateTime?
  paymentRef    String?
  proofUrl      String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  paidBy      User?   @relation("ExpensePaidBy", fields: [paidById], references: [id])

  @@index([projectId])
  @@index([budgetId])
  @@index([status])
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  void
}

model Invoice {
  id                   String        @id @default(cuid())
  code                 String        @unique
  projectId            String?
  organizationId       String
  status               InvoiceStatus @default(draft)
  currency             String        @default("NGN")
  amount               Decimal       @db.Decimal(14, 2)
  lineItems            Json
  issuedAt             DateTime?
  dueAt                DateTime?
  paidAt               DateTime?
  paymentRef           String?
  pdfUrl               String?
  /// Set when `finance_manager` confirms the funds landed. A receipt is only
  /// issued after this, and the confirmer may not be the budget approver.
  paymentConfirmedById String?
  paymentConfirmedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  project            Project?     @relation(fields: [projectId], references: [id])
  organization       Organization @relation(fields: [organizationId], references: [id])
  receipt            Receipt?
  paymentConfirmedBy User?        @relation("InvoicePaymentConfirmedBy", fields: [paymentConfirmedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

enum PaymentMethod {
  paystack
  bank_transfer
  cheque
  cash
  other
}

model Receipt {
  id             String        @id @default(cuid())
  code           String        @unique
  invoiceId      String?       @unique
  organizationId String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("NGN")
  paymentMethod  PaymentMethod @default(paystack)
  paymentRef     String?
  issuedAt       DateTime      @default(now())
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([paymentRef])
}

