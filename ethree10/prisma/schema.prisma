// ============================================================
// REPORTS, KPIs
// ============================================================

enum ReportLevel {
  member
  subunit
  team
  agency
  organization
}

enum ReportPeriod {
  weekly
  monthly
}

enum ReportStatus {
  draft
  finalized
}

enum ContributionType {
  assignment
  completion
  deliverable
  time
  collaboration
  review
  revision
  blocker
}

model Report {
  id            String       @id @default(cuid())
  level         ReportLevel
  period        ReportPeriod
  scopeId       String
  periodStart   DateTime
  periodEnd     DateTime
  metrics       Json
  narrative     Json?
  highlights    String?
  pdfUrl        String?
  authoredById  String?
  status        ReportStatus @default(draft)
  timezone      String       @default("Africa/Lagos")
  cutoffAt      DateTime
  finalizedAt   DateTime?
  finalizedById String?
  version       Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  authoredBy     User?                @relation("ReportAuthoredBy", fields: [authoredById], references: [id])
  finalizedBy    User?                @relation("ReportFinalizedBy", fields: [finalizedById], references: [id])
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  organizationId String?
  contributions  ReportContribution[]
  amendments     ReportAmendment[]

  @@unique([level, period, scopeId, periodStart])
  @@index([level, periodStart])
}

model ReportContribution {
  id             String           @id @default(cuid())
  reportId       String
  sourceKey      String
  type           ContributionType
  userId         String?
  taskId         String?
  projectId      String?
  organizationId String?
  teamId         String?
  summary        String
  outcome        String?
  effortHours    Decimal?         @db.Decimal(8, 2)
  occurredAt     DateTime
  metadata       Json?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sourceKey])
  @@index([reportId, userId])
  @@index([organizationId, occurredAt])
  @@index([teamId, occurredAt])
}

model ReportAmendment {
  id                String   @id @default(cuid())
  reportId          String
  amendedById       String
  reason            String
  previousMetrics   Json
  previousNarrative Json?
  newMetrics        Json
  newNarrative      Json?
  createdAt         DateTime @default(now())

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  amendedBy User   @relation(fields: [amendedById], references: [id])

  @@index([reportId, createdAt])
}

// Agency-global scorecard configs (the agency is implicit).
model ScorecardConfig {
  id        String      @id @default(cuid())
  level     ReportLevel
  scopeId   String // teamId or member userId
  name      String
  items     Json // array of ScorecardItem objects
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([level, scopeId])
}

model KpiSnapshot {
  id          String       @id @default(cuid())
  level       ReportLevel
  scopeId     String
  period      ReportPeriod
  periodStart DateTime
  periodEnd   DateTime
  scorecard   Json
  totalScore  Decimal      @db.Decimal(5, 2)
  rating      String?
  createdAt   DateTime     @default(now())

  @@unique([level, period, scopeId, periodStart])
}

